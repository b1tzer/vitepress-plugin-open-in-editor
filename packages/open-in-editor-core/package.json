{
  "name": "open-in-editor-core",
  "version": "0.1.0",
  "description": "Editor detection and argument building utilities (framework-agnostic).",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/index.mjs",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist --noEmit false"
  },
  "keywords": [
    "editor",
    "launch-editor",
    "open-in-editor",
    "vscode",
    "cursor",
    "windsurf"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}

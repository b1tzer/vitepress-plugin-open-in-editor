{
  "name": "vitepress-plugin-open-in-editor",
  "version": "0.1.2",
  "description": "Hover any paragraph, code block, table or list in a VitePress site and jump straight to the exact source line in your local editor. Works with VS Code Remote SSH and 20+ editors.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/index.mjs",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist --noEmit false"
  },
  "keywords": [
    "vitepress",
    "vite-plugin",
    "vscode",
    "open-in-editor",
    "click-to-source",
    "markdown-it",
    "remote-ssh"
  ],
  "author": "b1tzer <bltzer@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/b1tzer/vitepress-plugin-open-in-editor"
  },
  "bugs": {
    "url": "https://github.com/b1tzer/vitepress-plugin-open-in-editor/issues"
  },
  "homepage": "https://github.com/b1tzer/vitepress-plugin-open-in-editor#readme",
  "dependencies": {
    "open-in-editor-core": "0.1.0"
  },
  "peerDependencies": {
    "vite": ">=4",
    "vitepress": ">=1"
  },
  "engines": {
    "node": ">=18"
  }
}
